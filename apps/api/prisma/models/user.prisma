model Admin {
    id Int @id @default(autoincrement())
    name String

    email String @unique 
    password String
}

model Teacher {
  id                 String   @id @default(uuid())
  name               String
  phone              String   @unique // يستخدم لتسجيل الدخول
  email              String?  @unique
  password           String
  subject            String
  subscriptionStatus String   @default("TRIAL") // قيم مقترحة: "ACTIVE", "SUSPENDED", "TRIAL"
  pricePerStudent    Float    // سعر المحاسبة لكل طالب
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

//   assistants         Assistant[]
//   locations          Location[] // السناتر أو أماكن الشرح
//   groups             Group[]
//   students           TeacherStudent[]
//   invoices           Invoice[]
}