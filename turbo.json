{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      
      "outputs": ["dist/**", "build/**", ".next/**"]
    },

    "check-types": {
      "dependsOn": ["^check-types"]
    },

    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },

    
  }
}
